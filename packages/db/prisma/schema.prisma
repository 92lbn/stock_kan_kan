// Prisma schema — Gestion Restaurant
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id            String   @id @default(cuid())
  identifier    String   @unique // identifiant unique de connexion (employé ou admin)
  name          String
  passwordHash  String
  role          Role     @default(EMPLOYEE)
  isSuperAdmin  Boolean  @default(false) // compte protégé, non supprimable par personne
  canStock      Boolean  @default(false) // accès explicite à l'app Stock ; ADMIN autorisé implicitement
  hourlyRate    Decimal  @default(0) @db.Decimal(12, 2) // taux horaire en € pour le calcul de la paye
  sessionVersion Int     @default(0) // incrémenté pour révoquer les JWT existants (rôle/mdp/suppression)
  deletedAt     DateTime? // suppression réversible (soft delete)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shifts       Shift[]
  timeEntries  TimeEntry[]
  stockAlertsAck StockMovement[]
  ideas        ContentIdea[]     @relation("IdeaAuthor")
  mediaUploads MediaAsset[]      @relation("MediaUploader")
  ledgerEntries LedgerEntry[]
  notes        Note[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// Tentatives de connexion échouées (rate limiting, serverless-safe : état en base).
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@map("login_attempts")
}

// Journal d'audit : toute écriture sur stock, ledger et users.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // auteur de l'action (null si système)
  action    String // ex: "stock.create", "ledger.delete", "user.updateRole"
  entity    String // ex: "StockItem", "LedgerEntry", "User"
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Notes & rappels ----------

model Note {
  id         String    @id @default(cuid())
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  content    String
  remindAt   DateTime? // date/heure du rappel (optionnel)
  notifiedAt DateTime? // renseigné une fois la notification push envoyée
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([authorId])
  @@index([remindAt])
  @@map("notes")
}

// Abonnement Web Push (un appareil/navigateur par ligne)
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------- Module 1 : Stocks & Inventaire ----------

enum StockCategory {
  MATERIEL_INFORMATIQUE
  CONSOMMABLES
  ALIMENTAIRE
  HYGIENE
  EMBALLAGE
  // Catégories réelles du restaurant
  MENAGER_ENTRETIEN
  EPICERIE
  LEGUMES_FRAIS
  BOISSONS
  VIANDES_POISSONS
  CONSOMMABLES_EMBALLAGES
}

model StockItem {
  id           String        @id @default(cuid())
  name         String
  category     StockCategory
  unit         String // ex: "carton", "bouteille", "kg"
  quantity     Decimal       @default(0) @db.Decimal(12, 3)
  minThreshold Decimal       @default(0) @db.Decimal(12, 3)
  costPrice    Decimal       @default(0) @db.Decimal(12, 2) // coût unitaire (base food cost / valorisation)
  allergens    String? // allergènes portés par l'ingrédient (obligation légale FR)
  barcode      String?       @unique // code-barres (EAN/UPC) pour le scan
  deletedAt    DateTime? // suppression réversible (soft delete)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  movements         StockMovement[]
  recipeIngredients RecipeIngredient[]

  @@index([category])
  @@index([deletedAt])
  @@map("stock_items")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 2) // coût unitaire d'un achat (entrée IN)
  note        String?
  createdAt   DateTime          @default(now())
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  // Dépense compta correspondante (un achat IN peut générer une LedgerEntry).
  ledgerEntry   LedgerEntry?    @relation(fields: [ledgerEntryId], references: [id], onDelete: SetNull)
  ledgerEntryId String?

  @@index([stockItemId])
  @@map("stock_movements")
}

// ---------- Module 2 : Planning & Pointage ----------

model Shift {
  id        String   @id @default(cuid())
  employee  User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date      DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date, startTime]) // pas deux fois le même créneau
  @@index([employeeId, date])
  @@map("shifts")
}

enum TimeEntryType {
  CLOCK_IN
  CLOCK_OUT
}

model TimeEntry {
  id         String        @id @default(cuid())
  employee   User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  type       TimeEntryType
  timestamp  DateTime      @default(now())

  @@index([employeeId, timestamp])
  @@map("time_entries")
}

// ---------- Module 3 : Fichiers du restaurant & Recettes ----------

enum RecipeCategory {
  MENU
  BOISSON
  MARINADE
}

model Recipe {
  id           String         @id @default(cuid())
  title        String
  category     RecipeCategory
  ingredients  String // texte libre conservé (migration douce vers RecipeIngredient)
  steps        String // texte libre, une étape par ligne
  sellingPrice Decimal? @db.Decimal(12, 2) // prix de vente TTC pour le food cost %
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  recipeIngredients RecipeIngredient[]

  @@index([category])
  @@map("recipes")
}

// Ingrédient structuré d'une recette, relié à un article de stock (fiche technique,
// food cost, production, faisabilité).
model RecipeIngredient {
  id          String    @id @default(cuid())
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId    String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId String
  quantity    Decimal   @db.Decimal(12, 3) // quantité par portion, dans l'unité du stock
  unit        String

  @@unique([recipeId, stockItemId])
  @@index([recipeId])
  @@index([stockItemId])
  @@map("recipe_ingredients")
}

// ---------- Module 4 : Réseaux sociaux ----------

enum SocialPlatform {
  TIKTOK
  SNAPCHAT
  INSTAGRAM
}

model ContentIdea {
  id        String   @id @default(cuid())
  text      String
  author    User     @relation("IdeaAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())

  @@map("content_ideas")
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String // clé/URL sur Cloudflare R2
  fileName   String
  uploader   User     @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId String
  createdAt  DateTime @default(now())

  post       ScheduledPost?

  @@map("media_assets")
}

enum PostStatus {
  IDEA
  READY
  SCHEDULED
  PUBLISHED
}

model ScheduledPost {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  caption     String?
  status      PostStatus     @default(READY)
  scheduledAt DateTime?
  media       MediaAsset?    @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  mediaId     String?        @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([scheduledAt])
  @@map("scheduled_posts")
}

// CA prévisionnel par jour, pour le ratio masse salariale / CA (liaison compta ↔ planning).
model DailyForecast {
  id              String   @id @default(cuid())
  date            DateTime @unique @db.Date
  expectedRevenue Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("daily_forecasts")
}

// ---------- Suivi recettes / dépenses (comptabilité légère) ----------

enum LedgerEntryType {
  REVENUE
  EXPENSE
}

model LedgerEntry {
  id          String          @id @default(cuid())
  date        DateTime        @db.Date
  type        LedgerEntryType
  amount      Decimal         @db.Decimal(12, 2)
  category    String?
  note        String?
  deletedAt   DateTime? // suppression réversible (soft delete)
  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime        @default(now())

  stockMovements StockMovement[]

  @@index([date])
  @@index([deletedAt])
  @@map("ledger_entries")
}
