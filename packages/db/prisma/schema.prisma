// Prisma schema — Gestion Restaurant
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

model User {
  id            String   @id @default(cuid())
  identifier    String   @unique // identifiant unique de connexion (employé ou admin)
  name          String
  passwordHash  String
  pinHash       String? // code personnel de pointage kiosk, toujours stocké haché
  role          Role     @default(EMPLOYEE)
  isSuperAdmin  Boolean  @default(false) // compte protégé, non supprimable par personne
  canStock      Boolean  @default(false) // accès explicite à l'app Stock ; ADMIN autorisé implicitement
  hourlyRate    Decimal  @default(0) @db.Decimal(12, 2) // taux horaire en € pour le calcul de la paye
  sessionVersion Int     @default(0) // incrémenté pour révoquer les JWT existants (rôle/mdp/suppression)
  deletedAt     DateTime? // suppression réversible (soft delete)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shifts       Shift[]
  timeEntries  TimeEntry[]
  stockAlertsAck StockMovement[]
  notes        Note[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// Tentatives de connexion échouées (rate limiting, serverless-safe : état en base).
model LoginAttempt {
  id         String   @id @default(cuid())
  identifier String
  ip         String?
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

// Journal d'audit : écritures sensibles sur le stock et les utilisateurs.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // auteur de l'action (null si système)
  action    String // ex: "stock.create", "ledger.delete", "user.updateRole"
  entity    String // ex: "StockItem", "LedgerEntry", "User"
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------- Notes & rappels ----------

model Note {
  id         String    @id @default(cuid())
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String
  content    String
  remindAt   DateTime? // date/heure du rappel (optionnel)
  notifiedAt DateTime? // renseigné une fois la notification push envoyée
  notificationClaimedAt DateTime?
  notificationAttempts  Int       @default(0)
  lastNotificationError String?
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([authorId])
  @@index([remindAt])
  @@index([notificationClaimedAt])
  @@map("notes")
}

// Abonnement Web Push (un appareil/navigateur par ligne)
model PushSubscription {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ---------- Module 1 : Stocks & Inventaire ----------

enum StockCategory {
  MATERIEL_INFORMATIQUE
  CONSOMMABLES
  ALIMENTAIRE
  HYGIENE
  EMBALLAGE
  // Catégories réelles du restaurant
  MENAGER_ENTRETIEN
  EPICERIE
  LEGUMES_FRAIS
  BOISSONS
  VIANDES_POISSONS
  CONSOMMABLES_EMBALLAGES
}

model StockItem {
  id            String        @id @default(cuid())
  name          String
  category      StockCategory
  unit          String // ex: "carton", "bouteille", "kg"
  quantity      Decimal       @default(0) @db.Decimal(12, 3)
  minThreshold  Decimal       @default(0) @db.Decimal(12, 3)
  costPrice     Decimal       @default(0) @db.Decimal(12, 2) // coût unitaire (base food cost / valorisation)
  allergens     String? // allergènes portés par l'ingrédient (obligation légale FR)
  barcode       String?       @unique // code-barres (EAN/UPC) pour le scan
  imageData     Bytes? // photo compressée (max 350 ko), servie par une route authentifiée
  imageMimeType String?
  deletedAt     DateTime? // suppression réversible (soft delete)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  movements         StockMovement[]
  lots              StockLot[]

  @@index([category])
  @@index([deletedAt])
  @@map("stock_items")
}
model StockLot {
  id          String    @id @default(cuid())
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId String
  lotNumber   String?
  expiryDate  DateTime? @db.Date
  quantity    Decimal   @db.Decimal(12, 3)
  createdAt   DateTime  @default(now())

  @@index([stockItemId, expiryDate])
  @@index([expiryDate])
  @@map("stock_lots")
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id          String            @id @default(cuid())
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  stockItemId String
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 2) // coût unitaire d'un achat (entrée IN)
  note        String?
  createdAt   DateTime          @default(now())
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([stockItemId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ---------- Module 2 : Planning & Pointage ----------

model Shift {
  id        String   @id @default(cuid())
  employee  User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date      DateTime @db.Date
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date, startTime]) // pas deux fois le même créneau
  @@index([employeeId, date])
  @@index([date, startTime])
  @@map("shifts")
}

enum TimeEntryType {
  CLOCK_IN
  CLOCK_OUT
}

model TimeEntry {
  id         String        @id @default(cuid())
  employee   User          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  type       TimeEntryType
  timestamp  DateTime      @default(now())

  @@index([employeeId, timestamp])
  @@map("time_entries")
}
