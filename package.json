{
  "name": "stock_kan_kan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "postinstall": "npm run generate --workspace @stock-kan-kan/db",
    "db:migrate": "prisma migrate dev --config packages/db/prisma.config.ts",
    "db:deploy": "prisma migrate deploy --config packages/db/prisma.config.ts",
    "db:seed": "tsx packages/db/prisma/seed.ts",
    "db:import-inventory": "tsx packages/db/prisma/import-inventory.ts",
    "db:studio": "prisma studio --config packages/db/prisma.config.ts",
    "mono:dev": "turbo run dev",
    "mono:build": "turbo run build",
    "mono:lint": "turbo run lint",
    "mono:typecheck": "turbo run typecheck",
    "mono:test": "turbo run test"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "turbo": "^2.10.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
